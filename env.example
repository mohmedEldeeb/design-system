# micro-design-system — environment overrides
#
# Copy this file to `.env` and adjust as needed. All variables are OPTIONAL:
# the token pipeline falls back to the project defaults below, so an empty
# or missing .env is completely fine.
#
# Loaded via Node's `--env-file-if-exists=.env` in the tokens:* npm scripts.

# ── Token pipeline (scripts/build-source-tokens.ts) ────────────────────────
# Where the raw Figma variable dumps live (any *.json inside is merged).
TOKENS_RAW_DIR=./tokens/figma-raw

# Where the merged Style Dictionary source is written.
TOKENS_OUT_FILE=./tokens/tokens.json

# Optional dark-theme override map { "color.*.default": "#hex" } attached to
# matching color tokens as darkValue. Ignored if the file doesn't exist.
TOKENS_DARK_FILE=./tokens/dark-theme.json

# ── Dark theme placeholder generator (scripts/build-dark-theme.ts) ─────────
# Input: flat light-mode token map (dist/json/tokens.json by default).
TOKENS_FLAT_FILE=./dist/json/tokens.json

# Output: generated placeholder dark palette.
TOKENS_DARK_OUT=./tokens/dark-theme.json

# ── Storybook / test tooling ────────────────────────────────────────────────
# Port used by serve:storybook and test:stories.
STORYBOOK_PORT=6007
