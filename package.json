{
  "name": "micro-design-system",
  "version": "0.1.0",
  "private": false,
  "description": "Design tokens pipeline: Figma variables -> Style Dictionary -> CSS custom properties + Tailwind theme, previewed in Storybook. Radix UI primitives are installed and ready for the component layer.",
  "scripts": {
    "tokens:from-figma": "node scripts/build-source-tokens.js",
    "tokens:build": "node style-dictionary.config.js",
    "tokens:sync": "npm run tokens:from-figma && npm run tokens:build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "radix-ui": "^1.4.2"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.6.14",
    "@storybook/react": "^8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "storybook": "^8.6.14",
    "style-dictionary": "^4.3.3",
    "tailwindcss": "^3.4.17",
    "vite": "^5.4.11"
  }
}
